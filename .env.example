# Copy to .env and fill in. Every value here has a working default except the
# LLM judge key, so the service runs with an empty .env.

# ── Database ─────────────────────────────────────────────────────────────
# Host port the db container publishes on. Change it only if something else
# already owns 5432 (a native PostgreSQL install is the usual culprit) — then
# set both this and the port in DATABASE_URL to match, e.g. 5433.
DB_PORT=5432

# Host default. docker-compose overrides the host to the "db" service.
DATABASE_URL=postgresql+psycopg://llmsec:llmsec@localhost:5432/llmsec

# ── Auth ─────────────────────────────────────────────────────────────────
# Comma-separated keys accepted on the X-API-Key header.
# Leave empty to disable auth entirely (local development only).
API_KEYS=

# ── Service ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DETECTOR_TIMEOUT_SECONDS=10

# ── LLM judge ────────────────────────────────────────────────────────────
# Only ONE key is needed, whichever backend you use. Without a key the judge
# layer is skipped and the detectors fall back to their earlier layers.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
